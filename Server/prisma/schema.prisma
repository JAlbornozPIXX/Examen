generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Persona {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  Id_cargo           String?   @db.Uuid
  Alias              String?
  Nombres            String?
  Apellidos          String?
  RUN                Int       @unique @db.SmallInt
  Verificador        String
  Fecha_modificacion DateTime? @db.Timestamptz(6)
  User_id            String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cargo              Id_cargo? @relation(fields: [Id_cargo], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Id_cargo {
  id         String    @id(map: "cargo_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  Nombre     String?
  Persona    Persona[]

  @@schema("public")
}
