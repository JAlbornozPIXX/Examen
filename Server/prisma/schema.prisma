generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model personal_existente {
  id                                    String    @id(map: "Persona_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at                            DateTime  @default(now()) @db.Timestamptz(6)
  cargo                                 String?   @db.Uuid
  Alias                                 String?
  Nombres                               String?
  Apellidos                             String?
  RUN                                   Int       @unique(map: "Persona_RUN_key")
  Verificador                           String
  Fecha_modificacion                    DateTime? @default(now()) @db.Timestamptz(6)
  User_id                               String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cargo_personal_existente_cargoTocargo cargo?    @relation("personal_existente_cargoTocargo", fields: [cargo], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("personal-existente")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cargo {
  id                                                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at                                         DateTime             @default(now()) @db.Timestamptz(6)
  Nombre                                             String?
  personal_existente_personal_existente_cargoTocargo personal_existente[] @relation("personal_existente_cargoTocargo")

  @@schema("public")
}
