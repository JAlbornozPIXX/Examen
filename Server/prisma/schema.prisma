generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Id_cargo {
  id                                                       String               @id(map: "cargo_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at                                               DateTime             @default(now()) @db.Timestamptz(6)
  Nombre                                                   String?
  personal_existente_personal_existente_Id_cargoToId_cargo personal_existente[] @relation("personal_existente_Id_cargoToId_cargo")

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Usuarios_servicios {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  usuario    String?  @unique
  password   String?

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model personal_existente {
  id                                             String    @id(map: "Persona_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at                                     DateTime  @default(now()) @db.Timestamptz(6)
  Id_cargo                                       String?   @db.Uuid
  Alias                                          String?
  Nombres                                        String?
  Apellidos                                      String?
  RUN                                            Int       @unique(map: "Persona_RUN_key")
  Verificador                                    String
  Fecha_modificacion                             DateTime? @db.Timestamptz(6)
  User_id                                        String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Id_cargo_personal_existente_Id_cargoToId_cargo Id_cargo? @relation("personal_existente_Id_cargoToId_cargo", fields: [Id_cargo], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("personal-existente")
  @@schema("public")
}
